# URL del webhook de N8N al que se reenvían las solicitudes de material.
# Si se deja vacío, se usa la URL por defecto definida en settings.py.
# Para producción, apunta a la URL /webhook/ (no /webhook-test/).
N8N_WEBHOOK_URL=https://latiendahome-n8n-pruebas.wsxq6b.easypanel.host/webhook-test/pedir-material-tienda

# Clave secreta de Django (genera una larga y aleatoria en producción).
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion

# Hosts permitidos, separados por comas. "*" acepta cualquiera (tras proxy).
DJANGO_ALLOWED_HOSTS=*

# Orígenes de confianza para CSRF (ej. https://material.tudominio.com).
DJANGO_CSRF_TRUSTED_ORIGINS=

# Modo debug: false en producción.
DJANGO_DEBUG=false

# Ruta del fichero SQLite. En el contenedor por defecto es /data/db.sqlite3.
# IMPORTANTE: en Easypanel monta un VOLUMEN en /data para que el histórico no
# se borre en cada redeploy (ver README). No suele hacer falta cambiar esto.
# DJANGO_DB_PATH=/data/db.sqlite3

# Credenciales del panel de administración (/admin) para el equipo de marketing.
# Se crea/actualiza automáticamente al arrancar el contenedor.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambia-esta-contrasena
DJANGO_SUPERUSER_EMAIL=marketing@magashops.com
